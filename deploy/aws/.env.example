DALM_IMAGE_TAG=replace-with-full-commit-sha
DALM_JWT_SECRET=replace-with-existing-production-secret
# Start with the EXISTING database; change only after a verified data restore.
DALM_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE?ssl=require
DALM_INTERNAL_API_KEY=replace-with-existing-production-internal-key
DALM_APPLE_CLIENT_IDS=replace-with-production-bundle-id
AWS_DEFAULT_REGION=ap-northeast-2
DALM_S3_BUCKET=gachon-20-dalm-REPLACE-WITH-UNIQUE-SUFFIX
DALM_GCS_BUCKET=
# Set the existing production Redis URL during migration to preserve sessions.
# Leave unset to use the local persistent Redis container.
# DALM_REDIS_URL=redis://redis:6379/0
DALM_MOCK_VALIDATION_ON_UPLOAD=true
DALM_PHOTO_SIGNED_URL_TTL_SECONDS=900
